{
    "name": "tanaki/integration-contracts",
    "description": "Framework-agnostic interfaces, DTOs, enums, events, attributes, and exceptions for building Tanaki Hub hardware integration drivers.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["tanaki", "integration", "hardware", "driver", "contracts", "sdk"],
    "authors": [
        {
            "name": "Tanaki Hub",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.2",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Tanaki\\IntegrationContracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tanaki\\IntegrationContracts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.0.0",
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
